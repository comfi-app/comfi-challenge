    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.13.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
